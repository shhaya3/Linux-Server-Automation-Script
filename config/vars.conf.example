# Hardening Configuration
# Edit these before running harden.sh

# New non-root sudo user to create
NEW_USER="deploy"

# Custom SSH port (avoid default 22)
SSH_PORT="2222"

# Path to the public key that will be authorized for the new user.
# This should already exist on the SERVER (copy it there first if needed).
# Easiest: it will reuse root's/current admin's authorized_keys.
SSH_PUB_KEY_SOURCE="/root/.ssh/authorized_keys"

# Fail2Ban settings
F2B_MAXRETRY=3
F2B_BANTIME=3600
F2B_FINDTIME=600

# Additional TCP ports to allow through UFW besides SSH (space separated)
EXTRA_ALLOWED_PORTS="80 443"
